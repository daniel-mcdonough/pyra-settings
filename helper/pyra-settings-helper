#!/usr/bin/python3 -I
"""pyra-settings-helper: the root half of Pyra Settings.

Run through pkexec (polkit action org.pyra.settings.wake) by the GUI, and as root by
pyra-settings-apply.service at boot. Commands:

    set-wake game-buttons <codes>|none   codes: a kernel bitmap list, e.g. 102-109,272-273
    set-wake lid on|off
    set-nubs <key>=<value>...            edit the nub keys of /etc/pyrainput.cfg and reload pyrainput
    set-volume <key>=<value>...          edit cal, range, hsrange in /etc/pyra_volumed.conf and restart pyra_volumed
    apply                                reapply the config file to sysfs

set-wake writes sysfs first and the config file only if every sysfs write succeeded, so a write the kernel
refuses changes nothing. apply never writes the config. set-nubs checks every pair before it writes anything;
pyrainput's own file needs no boot apply, the daemon reads it at start (docs/nubs.md). set-volume is the same for
pyra_volumed's file (docs/volume-wheel.md).

Exit codes: 0 done, 1 a write or read failed, 2 the request was refused (bad arguments, unknown device, a code
the device doesn't have, the power button). 126 and 127 stay free for pkexec's own "dismissed" and "not
authorized".

The sysfs, config, pyrainput and pyra_volumed locations are the module constants below. Nothing from the caller (argument, environment)
can change them; only the test suite overrides them, by importing this file.
"""

import configparser
import os
import re
import subprocess
import sys

SYSFS_ROOT = "/sys/devices/platform"
CONFIG_PATH = "/etc/pyra-settings/pyra-settings.conf"
PYRAINPUT_PATH = "/etc/pyrainput.cfg"
# Reloads pyrainput if it runs, does nothing if it doesn't. ExecReload is SIGUSR1: the daemon resets its settings
# and rereads the file (docs/nubs.md).
PYRAINPUT_RELOAD = ["/usr/bin/systemctl", "try-reload-or-restart", "pyrainput.service"]
VOLUMED_PATH = "/etc/pyra_volumed.conf"
# pyra_volumed reads its file only at start and has no reload. try-restart leaves a stopped daemon stopped; it
# reads the file when it next starts (docs/volume-wheel.md).
VOLUMED_RESTART = ["/usr/bin/systemctl", "try-restart", "pyra_volumed.service"]

# Device names the caller may use, mapped to their sysfs directory under SYSFS_ROOT.
GAME_BUTTONS = "game-buttons"
LID = "lid"
DEVICES = {
    GAME_BUTTONS: "pyra-game-buttons",
    LID: "pyra-lid-wakeup",
}
# Names that mean the power button. Its wake is never changed (docs/design.md, "Not exposed").
POWER_BUTTON_NAMES = {"power", "power-button", "power_button", "palmas_power_button"}
KEY_POWER = 116
SW_LID = 0
KEY_MAX = 0x2FF

CONFIG_SECTION = "wake"

EXIT_OK = 0
EXIT_FAILED = 1
EXIT_REFUSED = 2

_LIST_RE = re.compile(r"^[0-9]{1,4}(-[0-9]{1,4})?(,[0-9]{1,4}(-[0-9]{1,4})?)*$")


class Refused(Exception):
    """The request is not allowed. Nothing was written."""


class Failed(Exception):
    """A read or write failed."""


def log(msg):
    print("pyra-settings-helper: " + msg, file=sys.stderr)


def parse_list(text):
    """Parse a kernel bitmap list ("54,97,102-109", "" for none) into a set of ints. Raises ValueError."""
    text = text.strip()
    if not text:
        return set()
    if not _LIST_RE.match(text):
        raise ValueError("not a code list: %r" % text)
    codes = set()
    for part in text.split(","):
        lo, _, hi = part.partition("-")
        lo = int(lo)
        hi = int(hi) if hi else lo
        if lo > hi or hi > KEY_MAX:
            raise ValueError("bad range: %r" % part)
        codes.update(range(lo, hi + 1))
    return codes


def format_list(codes):
    """A sorted comma list without ranges: the simplest form the kernel takes."""
    return ",".join(str(c) for c in sorted(codes))


def device_dir(name):
    if name in POWER_BUTTON_NAMES:
        raise Refused("the power button's wake is never changed")
    if name not in DEVICES:
        raise Refused("unknown device: %r" % name)
    return os.path.join(SYSFS_ROOT, DEVICES[name])


def read_attr(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError as e:
        raise Failed("cannot read %s: %s" % (path, e.strerror))


def write_attr(path, value):
    """One write() of value plus a newline, as `echo value > path` does."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_TRUNC)
        try:
            os.write(fd, (value + "\n").encode())
        finally:
            os.close(fd)
    except OSError as e:
        raise Failed("kernel refused %r for %s: %s" % (value, path, e.strerror))


def require_0053(dev, attr):
    """Patch 0053 adds wakeup_keys and wakeup_switches; every image has it. Detected by the file, never by kernel
    version. Without it the helper changes nothing."""
    if not os.path.exists(os.path.join(dev, attr)):
        raise Failed("no %s on %s: the kernel lacks dragonbox-pyra patch 0053" % (attr, os.path.basename(dev)))


def check_game_codes(dev, codes):
    if KEY_POWER in codes:
        raise Refused("code %d is the power key; its wake is never changed" % KEY_POWER)
    try:
        known = parse_list(read_attr(os.path.join(dev, "keys")))
    except ValueError as e:
        raise Failed("cannot parse %s/keys: %s" % (dev, e))
    unknown = codes - known
    if unknown:
        raise Refused("not a key on %s: %s" % (os.path.basename(dev), format_list(unknown)))


def apply_game_buttons(codes):
    """Make exactly `codes` wake the Pyra. Validates first, then writes sysfs."""
    dev = device_dir(GAME_BUTTONS)
    check_game_codes(dev, codes)
    require_0053(dev, "wakeup_keys")
    wakeup = os.path.join(dev, "power", "wakeup")
    if not codes:
        # "None" goes through power/wakeup until an empty wakeup_keys write is tested.
        write_attr(wakeup, "disabled")
    else:
        write_attr(os.path.join(dev, "wakeup_keys"), format_list(codes))
        # A previous "none" left the whole device disabled; power/wakeup still gates wakeup_keys.
        write_attr(wakeup, "enabled")


def apply_lid(on):
    dev = device_dir(LID)
    require_0053(dev, "wakeup_switches")
    wakeup = os.path.join(dev, "power", "wakeup")
    if not on:
        # The lid device has one registered input, the lid switch, so power/wakeup covers it, and an empty
        # wakeup_switches write is as untested as an empty wakeup_keys one.
        write_attr(wakeup, "disabled")
        return
    try:
        known = parse_list(read_attr(os.path.join(dev, "switches")))
    except ValueError as e:
        raise Failed("cannot parse %s/switches: %s" % (dev, e))
    if SW_LID not in known:
        raise Failed("%s has no lid switch" % os.path.basename(dev))
    write_attr(os.path.join(dev, "wakeup_switches"), str(SW_LID))
    write_attr(wakeup, "enabled")


def parse_game_value(text):
    """Config or argument value for game-buttons: "none", or a code list."""
    if text.strip() == "none":
        return set()
    codes = parse_list(text)
    if not codes:
        raise ValueError("empty code list (use \"none\")")
    return codes


def parse_lid_value(text):
    text = text.strip()
    if text not in ("on", "off"):
        raise ValueError("lid must be on or off, not %r" % text)
    return text == "on"


def read_config():
    """The config as a ConfigParser. A missing file is an empty config."""
    cp = configparser.ConfigParser(interpolation=None)
    try:
        with open(CONFIG_PATH) as f:
            cp.read_file(f)
    except FileNotFoundError:
        pass
    except (OSError, configparser.Error) as e:
        raise Failed("cannot read %s: %s" % (CONFIG_PATH, e))
    return cp


def save_config_value(key, value):
    """Set [wake] key = value, keeping every other setting, and replace the file atomically."""
    cp = read_config()
    if not cp.has_section(CONFIG_SECTION):
        cp.add_section(CONFIG_SECTION)
    cp.set(CONFIG_SECTION, key, value)
    directory = os.path.dirname(CONFIG_PATH)
    tmp = CONFIG_PATH + ".new"
    try:
        os.makedirs(directory, mode=0o755, exist_ok=True)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        with os.fdopen(fd, "w") as f:
            os.fchmod(f.fileno(), 0o644)
            cp.write(f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, CONFIG_PATH)
    except OSError as e:
        raise Failed("cannot write %s: %s" % (CONFIG_PATH, e.strerror))


def cmd_set_wake(args):
    if len(args) != 2:
        raise Refused("usage: set-wake game-buttons <codes>|none, or set-wake lid on|off")
    name, value = args
    device_dir(name)  # refuses the power button and unknown names before the value is looked at
    if name == GAME_BUTTONS:
        try:
            codes = parse_game_value(value)
        except ValueError as e:
            raise Refused(str(e))
        apply_game_buttons(codes)
        save_config_value(GAME_BUTTONS, format_list(codes) if codes else "none")
    else:
        try:
            on = parse_lid_value(value)
        except ValueError as e:
            raise Refused(str(e))
        apply_lid(on)
        save_config_value(LID, "on" if on else "off")


# The nub keys of pyrainput.cfg the helper may set, with their checks (docs/nubs.md). Everything else in the file
# (scripts.*, which the daemon runs as root, profile.*, PYRA_KEY_*, altmode.*, *.export) is never written.
NUB_AXIS_MODES = ("mouse_x", "mouse_y", "mouse_btn", "scroll_x", "scroll_y")
NUB_CLICK_MODES = ("mouse_left", "mouse_middle", "mouse_right", "nub_click_left", "nub_click_right")
NUB_MODE_KEYS = {
    "nubs.left.x": NUB_AXIS_MODES,
    "nubs.left.y": NUB_AXIS_MODES,
    "nubs.right.x": NUB_AXIS_MODES,
    "nubs.right.y": NUB_AXIS_MODES,
    "nubs.left.click": NUB_CLICK_MODES,
    "nubs.right.click": NUB_CLICK_MODES,
}
# Inclusive ranges. The nubs report -256..256, so a deadzone of 256 or more would switch the axis off.
NUB_INT_KEYS = {
    "nubs.deadzone": (0, 255),
    "mouse.deadzone": (0, 255),
    "mouse.wheel.deadzone": (0, 255),
    "mouse.click.deadzone": (0, 255),
    "mouse.sensitivity": (1, 1000),
    "mouse.wheel.sensitivity": (1, 1000),
}
NUB_NONE = "none"        # a mode key with no modes: the axis or click does nothing
NUB_DEFAULT = "default"  # remove the key, so the daemon's built-in value applies

# libpyrainput's line patterns (settings.cpp, loadConfig): a setting starts in column 0, a comment is a "#" in
# column 0, keys are case-insensitive and the last line for a key wins.
_PYRAINPUT_LINE_RE = re.compile(r"^([\w.]+)\s*=\s*(.*)$", re.ASCII)
_PROFILE_CURRENT = "profile.current"


def check_nub_value(key, value):
    """The value as it goes into the file, None for default. Raises ValueError."""
    value = value.strip()
    if value == NUB_DEFAULT:
        return None
    if key in NUB_MODE_KEYS:
        if value == NUB_NONE:
            return ""
        modes = value.split()
        allowed = NUB_MODE_KEYS[key]
        if not modes:
            raise ValueError("%s: no mode (use \"%s\")" % (key, NUB_NONE))
        for m in modes:
            if m not in allowed:
                raise ValueError("%s takes %s, not %r" % (key, "|".join(allowed), m))
        if len(set(modes)) != len(modes):
            raise ValueError("%s: a mode given twice" % key)
        return " ".join(modes)
    lo, hi = NUB_INT_KEYS[key]
    # The daemon reads these with std::stoi, which throws on anything that isn't a number and ends the daemon.
    if not re.fullmatch(r"[0-9]{1,4}", value, re.ASCII) or not lo <= int(value) <= hi:
        raise ValueError("%s must be a whole number %d-%d, not %r" % (key, lo, hi, value))
    return str(int(value))


def parse_nub_args(args):
    """key=value arguments as an ordered {key: file value or None}. Raises Refused."""
    if not args:
        raise Refused("usage: set-nubs <key>=<value>...")
    changes = {}
    for arg in args:
        key, sep, value = arg.partition("=")
        key = key.strip()
        if not sep:
            raise Refused("not key=value: %r" % arg)
        if key not in NUB_MODE_KEYS and key not in NUB_INT_KEYS:
            raise Refused("not a nub setting: %r" % key)
        if key in changes:
            raise Refused("%s given twice" % key)
        try:
            changes[key] = check_nub_value(key, value)
        except ValueError as e:
            raise Refused(str(e))
    return changes


def line_key(line):
    """The setting a pyrainput.cfg line sets, lowercased as the daemon does, or None."""
    m = _PYRAINPUT_LINE_RE.match(line.rstrip("\r\n"))
    return m.group(1).lower() if m else None


def edit_pyrainput(lines, changes):
    """Apply changes to the file's lines (each with its newline) and return the new lines.

    Every line that sets a changed key gets the new value in place, or goes for default; nothing else moves. A key
    not in the file goes above the first profile.current line: the daemon loads the profile where that line
    stands, so a key below it would override the profile pyrainputctl overload sets for a game."""
    out = []
    for line in lines:
        key = line_key(line)
        if key in changes:
            if changes[key] is not None:
                out.append(format_nub_line(key, changes[key]))
            continue
        out.append(line)
    present = {line_key(line) for line in lines}
    new = [format_nub_line(k, v) for k, v in changes.items() if v is not None and k not in present]
    if not new:
        return out
    at = next((i for i, line in enumerate(out) if line_key(line) == _PROFILE_CURRENT), len(out))
    if at > 0 and not out[at - 1].endswith("\n"):
        out[at - 1] += "\n"
    return out[:at] + new + out[at:]


def format_nub_line(key, value):
    return ("%s = %s" % (key, value)).rstrip() + "\n"


def write_file_atomic(path, text, mode):
    tmp = path + ".new"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w") as f:
            os.fchmod(f.fileno(), mode)
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except OSError as e:
        raise Failed("cannot write %s: %s" % (path, e.strerror))


def cmd_set_nubs(args):
    changes = parse_nub_args(args)
    try:
        with open(PYRAINPUT_PATH, newline="") as f:
            lines = f.readlines()
        mode = os.stat(PYRAINPUT_PATH).st_mode & 0o7777
    except FileNotFoundError:
        lines, mode = [], 0o644
    except OSError as e:
        raise Failed("cannot read %s: %s" % (PYRAINPUT_PATH, e.strerror))
    new = edit_pyrainput(lines, changes)
    if new != lines:
        write_file_atomic(PYRAINPUT_PATH, "".join(new), mode)
    try:
        result = subprocess.run(PYRAINPUT_RELOAD, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Failed("saved %s, but pyrainput was not reloaded: %s" % (PYRAINPUT_PATH, e))
    if result.returncode != 0:
        raise Failed("saved %s, but pyrainput was not reloaded: %s"
                     % (PYRAINPUT_PATH, result.stderr.decode(errors="replace").strip()))


# pyra_volumed.conf (docs/volume-wheel.md). The daemon reads each line with sscanf(" cal %lf ..."), " range %ld %ld"
# and " hsrange %ld %ld": leading blanks allowed, the keyword case-sensitive, a valid later line beating an earlier
# one, anything else ignored. The checks are the daemon's own, so it never drops what the helper wrote.
VOLUMED_NCAL = 5
VOLUMED_RAW_MAX = 4095   # palmas-gpadc is a 12-bit ADC
# The top step of the control each range spans: Handsfree Playback Volume (speakers) 0..29, Headset Playback
# Volume (headphones) 0..15. The daemon checks against the mixer's own maximum, which is these.
VOLUMED_RANGE_MAX = {"range": 29, "hsrange": 15}
VOLUMED_KEYS = ("cal",) + tuple(VOLUMED_RANGE_MAX)
# Every line the daemon could read as one of the keys, however malformed: a line the helper missed could come
# after the one it wrote and win. hsrange before range, or "hsrange" would never match.
_VOLUMED_LINE_RE = re.compile(r"^\s*(cal|hsrange|range)(?![A-Za-z_])", re.ASCII)
_UINT_RE = re.compile(r"^[0-9]{1,5}$", re.ASCII)


def parse_uints(value, count):
    words = value.split()
    if len(words) != count or not all(_UINT_RE.match(w) for w in words):
        raise ValueError("needs %d whole numbers: %r" % (count, value))
    return [int(w) for w in words]


def check_volumed_value(key, value):
    """The file's value for key, or None for default (drop the line). Raises ValueError."""
    if value.strip() == NUB_DEFAULT:
        return None
    if key == "cal":
        c = parse_uints(value, VOLUMED_NCAL)
        if c[0] < 1 or any(b <= a for a, b in zip(c, c[1:])) or c[-1] > VOLUMED_RAW_MAX:
            raise ValueError("cal must be positive and rising, at most %d: %r" % (VOLUMED_RAW_MAX, value))
        return " ".join(map(str, c))
    lo, hi = parse_uints(value, 2)
    if not 0 <= lo < hi <= VOLUMED_RANGE_MAX[key]:
        raise ValueError("%s must be 0 <= lo < hi <= %d: %r" % (key, VOLUMED_RANGE_MAX[key], value))
    return "%d %d" % (lo, hi)


def parse_volumed_args(args):
    """key=value arguments as an ordered {key: file value or None}. Raises Refused."""
    if not args:
        raise Refused("usage: set-volume <key>=<value>...")
    changes = {}
    for arg in args:
        key, sep, value = arg.partition("=")
        key = key.strip()
        if not sep:
            raise Refused("not key=value: %r" % arg)
        if key not in VOLUMED_KEYS:
            raise Refused("not a volume wheel setting: %r" % key)
        if key in changes:
            raise Refused("%s given twice" % key)
        try:
            changes[key] = check_volumed_value(key, value)
        except ValueError as e:
            raise Refused(str(e))
    return changes


def volumed_line_key(line):
    m = _VOLUMED_LINE_RE.match(line)
    return m.group(1) if m else None


def edit_volumed(lines, changes):
    """Apply changes to the file's lines (each with its newline) and return the new lines.

    The first line for a changed key gets the new value in place and any later ones go, so no stale line can win;
    default removes them all. A key not in the file goes at the end. Comments and other lines stay."""
    out, done = [], set()
    for line in lines:
        key = volumed_line_key(line)
        if key in changes:
            if changes[key] is not None and key not in done:
                out.append("%s %s\n" % (key, changes[key]))
            done.add(key)
            continue
        out.append(line)
    new = ["%s %s\n" % (k, v) for k, v in changes.items() if v is not None and k not in done]
    if new and out and not out[-1].endswith("\n"):
        out[-1] += "\n"
    return out + new


def cmd_set_volume(args):
    changes = parse_volumed_args(args)
    try:
        with open(VOLUMED_PATH, newline="") as f:
            lines = f.readlines()
        mode = os.stat(VOLUMED_PATH).st_mode & 0o7777
    except FileNotFoundError:
        lines, mode = [], 0o644   # world-readable: pyra-sound-applet reads it too
    except OSError as e:
        raise Failed("cannot read %s: %s" % (VOLUMED_PATH, e.strerror))
    new = edit_volumed(lines, changes)
    if new != lines:
        write_file_atomic(VOLUMED_PATH, "".join(new), mode)
    try:
        result = subprocess.run(VOLUMED_RESTART, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Failed("saved %s, but pyra_volumed was not restarted: %s" % (VOLUMED_PATH, e))
    if result.returncode != 0:
        raise Failed("saved %s, but pyra_volumed was not restarted: %s"
                     % (VOLUMED_PATH, result.stderr.decode(errors="replace").strip()))


def cmd_apply(args):
    """Apply every setting in the config. A missing key leaves the kernel default; one bad setting doesn't stop
    the others."""
    if args:
        raise Refused("usage: apply")
    cp = read_config()
    if not cp.has_section(CONFIG_SECTION):
        return EXIT_OK
    status = EXIT_OK
    section = cp[CONFIG_SECTION]
    for key in section:
        value = section[key]
        try:
            if key == GAME_BUTTONS:
                apply_game_buttons(parse_game_value(value))
            elif key == LID:
                apply_lid(parse_lid_value(value))
            else:
                log("ignoring unknown setting [%s] %s" % (CONFIG_SECTION, key))
        except (ValueError, Refused, Failed) as e:
            log("[%s] %s: %s" % (CONFIG_SECTION, key, e))
            status = EXIT_FAILED
    return status


COMMANDS = {
    "set-wake": cmd_set_wake,
    "set-nubs": cmd_set_nubs,
    "set-volume": cmd_set_volume,
    "apply": cmd_apply,
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        log("refused: usage: pyra-settings-helper set-wake <device> <value> | set-nubs <key>=<value>... | "
            "set-volume <key>=<value>... | apply")
        return EXIT_REFUSED
    try:
        return COMMANDS[argv[0]](argv[1:]) or EXIT_OK
    except Refused as e:
        log("refused: %s" % e)
        return EXIT_REFUSED
    except Failed as e:
        log(str(e))
        return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
