#!/bin/sh
set -e

# The config is written by the helper, not shipped, so dpkg doesn't remove it on purge.
if [ "$1" = "purge" ]; then
	rm -f /etc/pyra-settings/pyra-settings.conf /etc/pyra-settings/pyra-settings.conf.new
	rmdir --ignore-fail-on-non-empty /etc/pyra-settings 2>/dev/null || true
	# The CPU ceiling, only if the helper wrote it (its first line); one written by hand stays.
	if [ "$(head -n 1 /etc/default/pyra-thermal 2>/dev/null)" = "# Written by pyra-settings. No file means no CPU ceiling." ]; then
		rm -f /etc/default/pyra-thermal
	fi
	rm -f /etc/default/pyra-thermal.new
	# The rumble settings, likewise only if the helper wrote them.
	if [ "$(head -n 1 /etc/modprobe.d/pyra-settings-rumble.conf 2>/dev/null)" = "# Written by pyra-settings. Rumble on or off, and its full strength (twl6040-vibra, patch 0055)." ]; then
		rm -f /etc/modprobe.d/pyra-settings-rumble.conf
	fi
	rm -f /etc/modprobe.d/pyra-settings-rumble.conf.new
fi

#DEBHELPER#
